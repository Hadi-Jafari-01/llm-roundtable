# ==============================================================================
# OmniAI Hub — Production-Grade Git Ignore Architecture
# Tailored for WebExtensions (Manifest V3), Modern JavaScript & Tooling
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Browser Extension & Packaging Artifacts
# ------------------------------------------------------------------------------
# Chrome auto-generated indexed rulesets for declarativeNetRequest
_metadata/

# Extension packages & release bundles
*.crx
*.xpi
*.zip
*.tar.gz
*.tgz

# WebExtension command line tool artifacts (Mozilla web-ext, chrome cli)
web-ext-artifacts/
.web-extension-id

# Private Signing Keys & Certificates (CRITICAL: Never commit extension keys)
*.pem
*.key
*.pub
*.cert
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 2. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
web_modules/

# Package manager cache
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.pnpm-store/

# Install logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 3. Environment Variables, Local Configs & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template

# Local development credentials & keys
secrets.json
api_keys.json
local.config.js
config.local.json

# ------------------------------------------------------------------------------
# 4. Production Builds & Compiled Assets
# ------------------------------------------------------------------------------
dist/
build/
out/
release/
temp/
tmp/
.cache/
.parcel-cache/
.rollup.cache/

# Source maps (optional: un-comment if you do not want to publish source maps)
# *.map

# ------------------------------------------------------------------------------
# 5. Testing, Code Coverage & Linting
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/
playwright/.cache/
cypress/screenshots/
cypress/videos/

# Linter caches
.eslintcache
.stylelintcache
.prettiercache
tscommand-*.tmp.txt

# ------------------------------------------------------------------------------
# 6. Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 7. IDEs, Editors & Workspaces
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains (WebStorm, IntelliJ IDEA, etc.)
.idea/
*.iml
*.iws
*.ipr
cmake-build-*/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.#*

# ------------------------------------------------------------------------------
# 8. Miscellaneous & Temporary Local Files
# ------------------------------------------------------------------------------
*.log
*.bak
*.tmp
*.old
*.orig
*.rej