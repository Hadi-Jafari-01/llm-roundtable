{
  "manifest_version": 3,
  "name": "OmniAI Hub — Obsidian Silk Spatial Workspace",
  "version": "2.0.0",
  "description": "Infinite 2D spatial AI workspace. Run ChatGPT, Claude, Gemini, Perplexity, DeepSeek, and Grok on an unbounded canvas with synchronized multi-model prompt dispatch.",
  "author": "OmniAI Haute Digital Architecture",
  "action": {
    "default_title": "OmniAI Hub",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["js/background.js"],
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/injector.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "css/*",
        "css/components/*",
        "js/*",
        "js/modules/*",
        "manifest.webmanifest"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "omniai-hub@workspace.internal",
      "strict_min_version": "115.0"
    }
  }
}